<UserControl x:Class="RecordingsHelper.WPF.Views.TranscriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:RecordingsHelper.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    
    <UserControl.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <materialDesign:Card>
        <materialDesign:Card.Style>
            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                <Setter Property="Padding" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Width" Value="50"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </materialDesign:Card.Style>
        <Grid>
            <!-- Expanded View -->
            <Grid Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="{Binding TranscriptFileName}" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding TranscriptFileName}"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding LoadTranscriptCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="28"
                                Padding="8,4"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Load" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleSpeakerEditorCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28"
                                Padding="8,4"
                                Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,6,0"
                                ToolTip="Edit speaker names">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Speakers" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearTranscriptCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28"
                                Padding="8,4"
                                Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleCollapseCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Collapse Panel"
                                Width="20" Height="20">
                            <materialDesign:PackIcon Kind="{Binding CollapseIcon}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search Box -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search transcript..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="12"
                             Padding="8,6"
                             Margin="0,0,0,4">
                    </TextBox>
                    <TextBlock Text="{Binding SegmentCountText}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="4,0,0,0"
                               Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Speaker Editor Panel -->
                <Border Grid.Row="2"
                        Visibility="{Binding ShowSpeakerEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Speaker Name Mapping"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        
                        <ItemsControl ItemsSource="{Binding SpeakerMappings}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OriginalName}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Margin="0,0,4,0"/>
                                        
                                        <materialDesign:PackIcon Grid.Column="1"
                                                                 Kind="ArrowRight"
                                                                 Width="14"
                                                                 Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Margin="4,0"/>
                                        
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11"
                                                 Padding="4,2"
                                                 Margin="4,0,0,0"
                                                 materialDesign:HintAssist.Hint="New name"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Button Command="{Binding UpdateSpeakersCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Right"
                                Height="28"
                                Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" 
                                                         VerticalAlignment="Center" 
                                                         Width="16" 
                                                         Height="16" 
                                                         Margin="0,0,4,0"/>
                                <TextBlock Text="UPDATE &amp; SAVE" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Transcript List -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                        CornerRadius="4"
                        Margin="0,0,0,0">
                    <ListBox x:Name="TranscriptList"
                             ItemsSource="{Binding FilteredSegments}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="6,4"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Time and Speaker -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding StartTime, Converter={StaticResource TimeSpanToStringConverter}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="-" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding EndTime, Converter={StaticResource TimeSpanToStringConverter}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock FontSize="11"
                                                       FontStyle="Italic"
                                                       Opacity="0.7">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                        <Binding Path="Speaker"/>
                                                        <Binding Path="OriginalSpeaker" TargetNullValue="" FallbackValue="">
                                                            <Binding.Converter>
                                                                <converters:SpeakerOriginalConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Text -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Collapsed View -->
            <Button Command="{Binding ToggleCollapseCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:Card}, Path=ActualHeight}"
                    Padding="0"
                    Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="{Binding TranscriptFileName}">
                <Grid>
                    <TextBlock Text="{Binding TranscriptFileName}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Width="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=ActualHeight}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Button>
        </Grid>
    </materialDesign:Card>
</UserControl>
